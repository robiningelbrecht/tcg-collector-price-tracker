{% extends 'base.html.twig' %}
{% import 'collection/macros.html.twig' as m %}

{% set range = dashboard.range %}
{% set cards = dashboard.cards %}

{% block body %}
    <main class="mx-auto max-w-7xl px-4 pb-16 pt-6">
        {{ include('collection/_page-header.html.twig', {title: 'Collection price tracker'}) }}

        {% if cards is empty %}
            <div class="panel mb-4"><div class="empty">No priced cards yet.</div></div>
        {% else %}
            {% set best = dashboard.bestPerformer %}
            {% set worst = dashboard.worstPerformer %}
            <section class="mb-4 grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))] gap-3">
                <div class="panel">
                    <div class="kpi-l">Collection value</div>
                    <div class="kpi-v">{{ m.eur(dashboard.totalValue) }}</div>
                    <div class="kpi-s">{{ dashboard.pricedCopyCount }} priced copies · avg {{ m.eur(dashboard.totalValue / dashboard.pricedCopyCount) }}</div>
                </div>
                <div class="panel">
                    <div class="kpi-l">Change · {{ range.label }}</div>
                    {% if dashboard.change is not null %}
                        <div class="kpi-v"><span class="{{ m.trend(dashboard.change) }}">{{ m.signedEur(dashboard.change) }}</span></div>
                        <div class="kpi-s"><span class="{{ m.trend(dashboard.change) }}">{{ m.pct(dashboard.changePercentage) }}</span> like-for-like</div>
                    {% else %}
                        <div class="kpi-v"><span class="sub">—</span></div>
                        <div class="kpi-s">Not enough history yet</div>
                    {% endif %}
                </div>
                <div class="panel">
                    <div class="kpi-l">Up / down</div>
                    {% if dashboard.change is not null %}
                        <div class="kpi-v"><span class="up">{{ dashboard.risingCount }}</span> / <span class="down">{{ dashboard.fallingCount }}</span></div>
                        <div class="kpi-s">{{ dashboard.flatCount }} flat</div>
                    {% else %}
                        <div class="kpi-v"><span class="sub">—</span></div>
                        <div class="kpi-s">Not enough history yet</div>
                    {% endif %}
                </div>
                <div class="panel">
                    <div class="kpi-l">Best performer</div>
                    {% if best %}
                        <div class="kpi-v">{{ m.change(best.stats) }}</div>
                        <div class="kpi-s">{{ best.card.name }} · {{ best.card.setName }}</div>
                    {% else %}
                        <div class="kpi-v"><span class="sub">—</span></div>
                        <div class="kpi-s">Not enough history yet</div>
                    {% endif %}
                </div>
                <div class="panel">
                    <div class="kpi-l">Worst performer</div>
                    {% if worst %}
                        <div class="kpi-v">{{ m.change(worst.stats) }}</div>
                        <div class="kpi-s">{{ worst.card.name }} · {{ worst.card.setName }}</div>
                    {% else %}
                        <div class="kpi-v"><span class="sub">—</span></div>
                        <div class="kpi-s">Not enough history yet</div>
                    {% endif %}
                </div>
                <div class="panel">
                    <div class="kpi-l">Concentration</div>
                    <div class="kpi-v">{{ (dashboard.concentration * 100)|round }}%</div>
                    <div class="kpi-s">of value in the 10 most valuable cards</div>
                </div>
            </section>

            {% set valueChart = dashboard.valueChartData %}
            <section class="mb-4 grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
                <div class="panel">
                    <div class="mb-2 flex items-center justify-between gap-2">
                        <h2 class="panel-title">Collection value</h2>
                        <span class="sub">{{ range.label }} high {{ m.eur(max(valueChart.values)) }} · low {{ m.eur(min(valueChart.values)) }}</span>
                    </div>
                    <div class="relative h-[280px]"><canvas data-chart="value" data-chart-data="{{ valueChart|json_encode }}"></canvas></div>
                </div>
                <div class="panel">
                    <div class="mb-2"><h2 class="panel-title">Value by series</h2></div>
                    <div class="relative h-[280px]"><canvas data-chart="series" data-chart-data="{{ dashboard.seriesChartData|json_encode }}"></canvas></div>
                </div>
            </section>

            <section class="mb-4 grid gap-4 lg:grid-cols-3">
                {% for direction in ['up', 'down'] %}
                    <div class="panel">
                        <div class="mb-2 flex items-center justify-between gap-2">
                            <h2 class="panel-title">{{ direction == 'up' ? 'Top risers' : 'Top fallers' }}</h2>
                            <nav class="seg sm" data-tabs="mover-mode">
                                {% for option in moverModes %}
                                    <button type="button" data-tab="{{ option.value }}" class="{{ loop.first ? 'on' }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ option.label }}</button>
                                {% endfor %}
                            </nav>
                        </div>
                        {% for mode in moverModes %}
                            <div data-tab-pane="mover-mode" data-tab="{{ mode.value }}" {{ loop.first ? '' : 'hidden' }}>
                                {% for mover in direction == 'up' ? dashboard.risers(mode) : dashboard.fallers(mode) %}
                                    {% set stats = mover.stats %}
                                    {% set right %}
                                        {% if mode.value == 'pct' %}
                                            <span class="{{ m.trend(stats.changePercentage) }}">{{ m.pct(stats.changePercentage) }}</span><small>{{ m.eur(stats.first) }} → {{ m.eur(stats.last) }}</small>
                                        {% else %}
                                            <span class="{{ m.trend(stats.change) }}">{{ m.signedEur(stats.change) }}</span><small>{{ m.pct(stats.changePercentage) }}{{ mover.card.pricedCount > 1 ? ' · ×' ~ mover.card.pricedCount }}</small>
                                        {% endif %}
                                    {% endset %}
                                    {{ m.item(mover, right) }}
                                {% else %}
                                    <div class="empty">{{ dashboard.rangeComplete ? 'Nothing went ' ~ direction ~ ' in this range.' : 'Not enough history yet for ' ~ range.label ~ '.' }}</div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}

                <div class="panel">
                    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                        {% for view in insightViews %}
                            <h2 class="panel-title" data-tab-pane="insight" data-tab="{{ view.value }}" {{ loop.first ? '' : 'hidden' }}>{{ view.title }}</h2>
                        {% endfor %}
                        <nav class="seg sm" data-tabs="insight">
                            {% for option in insightViews %}
                                <button type="button" data-tab="{{ option.value }}" class="{{ loop.first ? 'on' }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ option.label }}</button>
                            {% endfor %}
                        </nav>
                    </div>
                    <div data-tab-pane="insight" data-tab="volatile">
                        {% for card in dashboard.mostVolatile %}
                            {% set right %}{{ (card.stats.volatility * 100)|round }}%<small>annualised · {{ range.label }}</small>{% endset %}
                            {{ m.item(card, right) }}
                        {% else %}
                            <div class="empty">Not enough history yet for {{ range.label }}.</div>
                        {% endfor %}
                    </div>
                    <div data-tab-pane="insight" data-tab="near-high" hidden>
                        {% for card in dashboard.historyDays > 0 ? dashboard.nearTwoYearHigh : [] %}
                            {% set stats = card.twoYearStats %}
                            {% set right %}
                                {% if stats.atHigh %}
                                    <span class="up">At high</span><small>{{ m.eur(stats.high) }}</small>
                                {% else %}
                                    {{ m.pct(stats.fromHigh) }}<small>high {{ m.eur(stats.high) }}</small>
                                {% endif %}
                            {% endset %}
                            {{ m.item(card, right) }}
                        {% else %}
                            <div class="empty">Not enough history yet.</div>
                        {% endfor %}
                    </div>
                    <div data-tab-pane="insight" data-tab="below-high" hidden>
                        {% for card in dashboard.furthestBelowTwoYearHigh %}
                            {% set stats = card.twoYearStats %}
                            {% set right %}<span class="down">{{ m.pct(stats.fromHigh) }}</span><small>high {{ m.eur(stats.high) }} · {{ stats.highOn|date('j M Y') }}</small>{% endset %}
                            {{ m.item(card, right) }}
                        {% else %}
                            <div class="empty">{{ dashboard.historyDays > 0 ? 'No card is below its high.' : 'Not enough history yet.' }}</div>
                        {% endfor %}
                    </div>
                </div>
            </section>

            <section class="mb-4">
                <div class="panel">
                    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                        <h2 class="panel-title">Value by set</h2>
                        <span class="sub">bar colour = set performance over selected range</span>
                    </div>
                    <div class="relative h-[280px]"><canvas data-chart="sets" data-chart-data="{{ dashboard.setChartData|json_encode }}"></canvas></div>
                </div>
            </section>
        {% endif %}
    </main>
{% endblock %}
