{% import 'macros.html.twig' as m %}
{% set placeholder = asset('images/card-placeholder.svg') %}
<div class="grid gap-5 p-5 md:grid-cols-[220px_minmax(0,1fr)]">
    <div>
        <img src="{{ card.image ? card.image ~ '/high.webp' : placeholder }}" alt="{{ card.name }}" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='{{ placeholder }}'" class="aspect-[63/88] w-full max-w-[220px] rounded-lg bg-chip object-cover">
    </div>
    <div class="min-w-0">
        <h1 class="m-0 text-xl font-bold">{{ card.name }}{{ m.tags(card) }}</h1>
        <div class="sub">
            {{ [card.setName, card.number, card.rarity, card.serieName, rank ? '#' ~ rank ~ ' in collection' : null]|filter(v => v)|join(' · ') }}
        </div>
        {% if card.priced %}
            <div class="mt-2.5 flex flex-wrap gap-1.5" data-chips></div>
            <div class="mb-2 mt-3.5 flex flex-wrap items-center justify-between gap-2">
                <span class="sub">Value history · 30-day moving average dashed</span>
                <div class="seg sm" data-range></div>
            </div>
            <div class="relative h-[240px]"><canvas data-chart></canvas></div>
            <div class="mt-3.5 grid grid-cols-[repeat(auto-fit,minmax(130px,1fr))] gap-2.5" data-stats></div>
            <script type="application/json" data-card-history>{{ history|raw }}</script>
        {% else %}
            <div class="empty mt-3">No price for this card yet.</div>
        {% endif %}
        <div class="mt-3.5">
            <div class="kpi-l mb-1">Variants</div>
            {% for variant in card.variants %}
                {% set price = variant.latestPrice %}
                <div class="it cursor-default">
                    <div class="n"><b>{{ variant.variantName }}</b><span>×{{ variant.count }}</span></div>
                    <div class="r">
                        {% if price %}
                            {{ m.eur(price.trend) }}<small>{{ variant.count > 1 ? m.eur(price.trend * variant.count) ~ ' total' : 'per copy' }}</small>
                        {% else %}
                            <span class="sub">No price</span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
