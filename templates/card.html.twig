{% import 'macros.html.twig' as m %}
{% set card = detail.card %}
{% set range = detail.range %}
{% set stats = detail.stats %}
{% set placeholder = asset('images/card-placeholder.svg') %}
<div class="grid gap-5 p-5 md:grid-cols-[220px_minmax(0,1fr)]">
    <div>
        <img src="{{ card.image ? card.image ~ '/high.webp' : placeholder }}" alt="{{ card.name }}" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='{{ placeholder }}'" class="aspect-[63/88] w-full max-w-[220px] rounded-lg bg-chip object-cover">
    </div>
    <div class="min-w-0">
        <h1 class="m-0 text-xl font-bold">{{ card.name }}{{ m.tags(card) }}</h1>
        <div class="sub">
            {{ [card.setName, card.number, card.rarity, card.serieName, detail.rank ? '#' ~ detail.rank ~ ' in collection' : null]|filter(v => v)|join(' · ') }}
        </div>
        {% if stats %}
            <div class="mt-2.5 flex flex-wrap gap-1.5">
                {% for change in detail.changes %}
                    <span class="chip">{{ change.range.label }} <b class="{{ m.trend(change.changePercentage) }}">{{ m.pct(change.changePercentage) }}</b></span>
                {% else %}
                    <span class="sub">Changes show up once there are 7 days of price history.</span>
                {% endfor %}
            </div>
            <div class="mb-2 mt-3.5 flex flex-wrap items-center justify-between gap-2">
                <span class="sub">Value history · 30-day moving average dashed</span>
                <nav class="seg sm">
                    {% for option in ranges %}
                        {% set covered = detail.covers(option) %}
                        <button type="button" data-card-url="{{ path('card', {cardId: card.cardId, range: option.value}) }}" class="{{ option == range ? 'on' }} {{ covered ? '' : 'partial' }}" title="{{ m.rangeTitle(covered, detail.priceDayCount) }}">{{ option.label }}</button>
                    {% endfor %}
                </nav>
            </div>
            <div class="relative h-[240px]"><canvas data-chart="card" data-chart-data="{{ detail.chartData|json_encode }}"></canvas></div>
            <div class="mt-3.5 grid grid-cols-[repeat(auto-fit,minmax(130px,1fr))] gap-2.5">
                <div class="stat"><div class="l">Holding value</div><div class="v">{{ m.eur(stats.last) }}</div></div>
                {% set period = stats.complete ? range.label : 'since ' ~ stats.firstOn|date('j M') %}
                <div class="stat"><div class="l">Change · {{ range.label }}</div><div class="v">{% if stats.complete %}<span class="{{ m.trend(stats.change) }}">{{ m.signedEur(stats.change) }} ({{ m.pct(stats.changePercentage) }})</span>{% else %}<span class="sub">—</span>{% endif %}</div></div>
                <div class="stat"><div class="l">High · {{ period }}</div><div class="v">{{ m.eur(stats.high) }} <span class="sub">{{ stats.highOn|date('j M Y') }}</span></div></div>
                <div class="stat"><div class="l">Low · {{ period }}</div><div class="v">{{ m.eur(stats.low) }} <span class="sub">{{ stats.lowOn|date('j M Y') }}</span></div></div>
                <div class="stat"><div class="l">From high</div><div class="v">{% if stats.atHigh %}<span class="up">At high</span>{% else %}<span class="down">{{ m.pct(stats.fromHigh) }}</span>{% endif %}</div></div>
                <div class="stat"><div class="l">Max drawdown · {{ period }}</div><div class="v">{% if stats.maxDrawdown < 0 %}<span class="down">{{ m.pct(stats.maxDrawdown) }}</span>{% else %}<span class="sub">None</span>{% endif %}</div></div>
                <div class="stat"><div class="l">Volatility</div><div class="v">{% if stats.complete %}{{ (stats.volatility * 100)|round }}% <span class="sub">annualised</span>{% else %}<span class="sub">—</span>{% endif %}</div></div>
            </div>
        {% else %}
            <div class="empty mt-3">No price for this card yet.</div>
        {% endif %}
        <div class="mt-3.5">
            <div class="kpi-l mb-1">Variants</div>
            {% for variant in card.variants %}
                {% set price = variant.latestPrice %}
                <div class="it cursor-default">
                    <div class="n"><b>{{ variant.label }}</b><span>×{{ variant.count }}</span></div>
                    <div class="r">
                        {% if price %}
                            {{ m.eur(price.trend) }}<small>{{ variant.count > 1 ? m.eur(price.trend * variant.count) ~ ' total' : 'per copy' }}</small>
                        {% else %}
                            <span class="sub">{{ variant.missingPriceReason.label }}</span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
