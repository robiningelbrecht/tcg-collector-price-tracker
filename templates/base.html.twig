<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex,nofollow">
        <meta name="theme-color" content="#1B1D1E">
        <meta name="csrf-token" content="{{ csrf_token('dispatch-command') }}">
        <meta name="dispatch-command-url" content="{{ path('dispatch_command') }}">
        <title>{% block title %}TCG Price Tracker{% endblock %}</title>
        <link href="{{ asset('favicon.svg') }}" type="image/svg+xml" rel="icon">
        <link href="{{ asset('css/dist/tailwind.min.css') }}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-page font-sans text-sm leading-[1.45] text-ink antialiased">
        <header class="sticky top-0 z-40 bg-dark-900 shadow-[0_1px_0_var(--color-dark-700)]">
            <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4">
                <a href="{{ path('dashboard') }}" class="flex shrink-0 items-center gap-3">
                    <span class="block h-8 w-[30px] overflow-hidden sm:hidden">
                        <img src="https://static.tcgcollector.com/build/images/tcgcollector-logo-with-text-light.15508095.svg" alt="TCG Collector" referrerpolicy="no-referrer" class="-ml-[6px] h-8 w-auto max-w-none">
                    </span>
                    <img src="https://static.tcgcollector.com/build/images/tcgcollector-logo-with-text-light.15508095.svg" alt="TCG Collector" referrerpolicy="no-referrer" class="hidden h-7 w-auto sm:block">
                    <span class="hidden h-5 w-px bg-dark-600 sm:block"></span>
                    <span class="hidden text-[13px] font-semibold text-dark-300 sm:block">Price tracker</span>
                </a>
                <nav class="flex items-center gap-1">
                    {% set route = app.request.attributes.get('_route') %}
                    {% for name, label in {dashboard: 'Dashboard', collection: 'Collection'} %}
                        <a href="{{ path(name, app.request.query.has('range') ? {range: app.request.query.get('range')} : {}) }}" class="rounded-md px-2 py-2 text-[13px] font-semibold sm:px-3 {{ route == name ? 'bg-dark-700 text-dark-100' : 'text-dark-300 hover:text-white' }}" {{ route == name ? 'aria-current="page"' }}>{{ label }}</a>
                    {% endfor %}
                    <a href="{{ path('register_owned_card') }}" class="btn ml-2" aria-label="Add card">+<span class="ml-1 hidden sm:inline">Add card</span></a>
                </nav>
            </div>
        </header>
        {% block body %}{% endblock %}
        <div class="modal" data-card-modal>
            <div class="relative w-full max-w-[980px] overflow-hidden rounded-xl border border-line bg-panel">
                <div class="flex items-center justify-between bg-dark-900 px-5 py-3">
                    <img src="https://static.tcgcollector.com/build/images/tcgcollector-logo-with-text-light.15508095.svg" alt="TCG Collector" referrerpolicy="no-referrer" class="h-5 w-auto">
                    <button aria-label="Close" class="grid size-8 cursor-pointer place-items-center rounded-md bg-dark-700 text-lg text-dark-100 hover:bg-brand hover:text-white" data-card-modal-close>×</button>
                </div>
                <div data-card-modal-body></div>
            </div>
        </div>
        <script src="{{ asset('js/dist/app.min.js') }}" type="module"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
