<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex,nofollow">
        <meta name="theme-color" content="#1B1D1E">
        <meta name="csrf-token" content="{{ csrf_token('dispatch-command') }}">
        <meta name="dispatch-command-url" content="{{ path('dispatch_command') }}">
        <title>{% block title %}TCG Price Tracker{% endblock %}</title>
        <script>if (localStorage.getItem('hidePrices')) document.documentElement.classList.add('prices-hidden');</script>
        <link href="{{ asset('favicon.svg') }}" type="image/svg+xml" rel="icon">
        <link href="{{ asset('css/dist/tailwind.min.css') }}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-page font-sans text-sm leading-[1.45] text-ink antialiased">
        {% set route = app.request.attributes.get('_route') %}
        {% set pageQuery = app.request.query.has('range') ? {range: app.request.query.get('range')} : {} %}
        {% set pages = {dashboard: 'Dashboard', collection: 'Collection'} %}
        <header class="group sticky top-0 z-40 bg-dark-900 shadow-[0_1px_0_var(--color-dark-700)]">
            <input type="checkbox" id="menu-toggle" class="sr-only" aria-label="Toggle menu">
            <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4">
                <a href="{{ path('dashboard') }}" class="flex shrink-0 items-center gap-3">
                    <img src="https://static.tcgcollector.com/build/images/tcgcollector-logo-with-text-light.15508095.svg" alt="TCG Collector" referrerpolicy="no-referrer" class="h-6 w-auto sm:h-7">
                    <span class="hidden h-5 w-px bg-dark-600 sm:block"></span>
                    <span class="hidden text-[13px] font-semibold text-dark-300 sm:block">Price tracker</span>
                </a>
                <nav class="ml-auto hidden items-center gap-1 md:flex">
                    {% for name, label in pages %}
                        <a href="{{ path(name, pageQuery) }}" class="rounded-md px-3 py-2 text-[13px] font-semibold {{ route == name ? 'bg-dark-700 text-dark-100' : 'text-dark-300 hover:text-white' }}" {{ route == name ? 'aria-current="page"' }}>{{ label }}</a>
                    {% endfor %}
                    <a href="{{ path('register_owned_card') }}" class="btn ml-2">+ Add card</a>
                </nav>
                <div class="flex items-center gap-2">
                    <button type="button" data-price-toggle aria-pressed="false" aria-label="Hide prices" title="Hide prices" class="grid size-9 cursor-pointer place-items-center rounded-md border border-dark-600 text-dark-100 hover:bg-dark-700">
                        <svg aria-hidden="true" class="size-5 in-[.prices-hidden]:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg aria-hidden="true" class="hidden size-5 in-[.prices-hidden]:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10.6 5.1A10.4 10.4 0 0 1 12 5c6.5 0 10 7 10 7a17.6 17.6 0 0 1-2.6 3.6M6.6 6.6C3.7 8.5 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18"/></svg>
                    </button>
                    <label for="menu-toggle" class="grid size-9 cursor-pointer place-items-center rounded-md border border-dark-600 text-dark-100 select-none hover:bg-dark-700 group-has-[#menu-toggle:focus-visible]:ring-2 group-has-[#menu-toggle:focus-visible]:ring-brand md:hidden">
                        <svg aria-hidden="true" class="size-5 group-has-[#menu-toggle:checked]:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                        <svg aria-hidden="true" class="hidden size-5 group-has-[#menu-toggle:checked]:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </label>
                </div>
            </div>
            <nav class="hidden border-t border-dark-700 max-md:group-has-[#menu-toggle:checked]:block">
                <div class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-3">
                    {% for name, label in pages %}
                        <a href="{{ path(name, pageQuery) }}" class="rounded-md px-3 py-2.5 text-sm font-semibold {{ route == name ? 'bg-dark-700 text-dark-100' : 'text-dark-300 hover:bg-dark-800 hover:text-white' }}" {{ route == name ? 'aria-current="page"' }}>{{ label }}</a>
                    {% endfor %}
                    <a href="{{ path('register_owned_card') }}" class="btn mt-2 justify-center py-2.5">+ Add card</a>
                </div>
            </nav>
        </header>
        {% block body %}{% endblock %}
        <div class="modal" data-card-modal>
            <div class="relative w-full max-w-[980px] overflow-hidden rounded-xl border border-line bg-panel">
                <div class="flex items-center justify-between bg-dark-900 px-5 py-3">
                    <img src="https://static.tcgcollector.com/build/images/tcgcollector-logo-with-text-light.15508095.svg" alt="TCG Collector" referrerpolicy="no-referrer" class="h-5 w-auto">
                    <button aria-label="Close" class="grid size-8 cursor-pointer place-items-center rounded-md bg-dark-700 text-lg text-dark-100 hover:bg-brand hover:text-white" data-card-modal-close>×</button>
                </div>
                <div data-card-modal-body></div>
            </div>
        </div>
        <script src="{{ asset('js/dist/app.min.js') }}" type="module"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
