<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex,nofollow">
        <meta name="theme-color" content="#1B1D1E">
        <title>{% block title %}TCG Price Tracker{% endblock %}</title>
        <link href="{{ asset('favicon.svg') }}" type="image/svg+xml" rel="icon">
        <link href="{{ asset('css/dist/tailwind.min.css') }}" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-page font-sans text-sm leading-[1.45] text-ink antialiased">
        <header class="sticky top-0 z-40 bg-dark-900 shadow-[0_1px_0_var(--color-dark-700)]">
            <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4">
                <a href="{{ path('dashboard') }}" class="flex items-center gap-3">
                    <img src="https://static.tcgcollector.com/build/images/tcgcollector-logo-with-text-light.15508095.svg" alt="TCG Collector" referrerpolicy="no-referrer" class="h-6 w-auto sm:h-7">
                    <span class="hidden h-5 w-px bg-dark-600 sm:block"></span>
                    <span class="hidden text-[13px] font-semibold text-dark-300 sm:block">Price tracker</span>
                </a>
            </div>
        </header>
        {% block body %}{% endblock %}
        <script src="{{ asset('js/dist/app.min.js') }}" type="module"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
