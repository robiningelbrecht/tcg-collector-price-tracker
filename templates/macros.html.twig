{% macro eur(value) %}€{{ value|abs >= 100 ? value|round|number_format(0, '.', ',') : value|number_format(2, '.', ',') }}{% endmacro %}

{% macro signedEur(value) %}{{ value >= 0 ? '+' : '−' }}{{ _self.eur(value|abs) }}{% endmacro %}

{% macro pct(value) %}{{ value >= 0 ? '+' : '−' }}{{ (value|abs * 100)|number_format(1) }}%{% endmacro %}

{% macro trend(value) %}{{ value >= 0 ? 'up' : 'down' }}{% endmacro %}

{% macro tags(card) %}{% if card.language.value == 'ja' %}<span class="tag">JP</span>{% endif %}{% if card.count > 1 %}<span class="tag">×{{ card.count }}</span>{% endif %}{% if card.fromNewSet %}<span class="tag">NEW</span>{% endif %}{% endmacro %}

{% macro thumb(card) %}{% set placeholder = asset('images/card-placeholder.svg') %}<img class="thumb" loading="lazy" referrerpolicy="no-referrer" src="{{ card.image ? card.image ~ '/low.webp' : placeholder }}" alt="" onerror="this.onerror=null;this.src='{{ placeholder }}'">{% endmacro %}

{% macro cardUrl(card) %}{{ path('card', {language: card.language.value, cardId: card.cardId}) }}{% endmacro %}

{% macro item(dashboardCard, right) %}
    {% set card = dashboardCard.card %}
    <div class="it" data-card-url="{{ _self.cardUrl(card) }}">
        {{ _self.thumb(card) }}
        <div class="n"><b>{{ card.name }}{{ _self.tags(card) }}</b><span>{{ card.setName }} · {{ card.number }}</span></div>
        <div class="r">{{ right }}</div>
    </div>
{% endmacro %}
