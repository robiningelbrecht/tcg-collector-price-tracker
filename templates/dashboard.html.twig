{% extends 'base.html.twig' %}

{% block body %}
    <main class="mx-auto max-w-7xl px-4 pb-16 pt-6">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-4">
            <div>
                <h1 class="m-0 text-2xl font-bold">Collection price tracker</h1>
                <div class="sub">
                    {{ cardCount }} cards · {{ pricedCardCount }} priced · Cardmarket trend (EUR){% if lastDate %} · {{ lastDate|date('j M Y') }}{% endif %}
                </div>
            </div>
            <div class="seg" id="range"></div>
        </div>

        <section class="mb-4 grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))] gap-3" id="kpis"></section>

        <section class="mb-4 grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
            <div class="panel">
                <div class="mb-2 flex items-center justify-between gap-2"><h2 class="panel-title">Collection value</h2><span class="sub" id="pvSub"></span></div>
                <div class="relative h-[280px]"><canvas id="pvChart"></canvas></div>
            </div>
            <div class="panel">
                <div class="mb-2"><h2 class="panel-title">Value by series</h2></div>
                <div class="relative h-[280px]"><canvas id="eraChart"></canvas></div>
            </div>
        </section>

        <section class="mb-4 grid gap-4 lg:grid-cols-2">
            <div class="panel">
                <div class="mb-2 flex items-center justify-between gap-2"><h2 class="panel-title">Top risers</h2><div class="seg sm" data-mode></div></div>
                <div id="risers"></div>
            </div>
            <div class="panel">
                <div class="mb-2 flex items-center justify-between gap-2"><h2 class="panel-title">Top fallers</h2><div class="seg sm" data-mode></div></div>
                <div id="fallers"></div>
            </div>
        </section>

        <section class="mb-4 grid gap-4 lg:grid-cols-3">
            <div class="panel"><h2 class="panel-title mb-3">Most volatile</h2><div id="volatile"></div></div>
            <div class="panel"><h2 class="panel-title mb-3">At or near 2-year high</h2><div id="nearHigh"></div></div>
            <div class="panel"><h2 class="panel-title mb-3">Furthest below 2-year high</h2><div id="belowHigh"></div></div>
        </section>

        <section class="mb-4">
            <div class="panel">
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2"><h2 class="panel-title">Value by set</h2><span class="sub">bar colour = set performance over selected range</span></div>
                <div class="relative h-[280px]"><canvas id="setChart"></canvas></div>
            </div>
        </section>

        <section class="panel">
            <div class="mb-2 flex items-center justify-between gap-2"><h2 class="panel-title">All cards</h2><span class="sub" id="tblCount"></span></div>
            <div class="flex flex-wrap items-center gap-2">
                <input id="q" type="search" placeholder="Search card or set…" class="field min-w-0 flex-1 sm:max-w-xs">
                <select id="eraF" class="field"><option value="">All series</option></select>
                <select id="regF" class="field"><option value="">All regions</option><option value="EN">International</option><option value="JP">Japanese</option></select>
            </div>
            <div class="mt-3 overflow-x-auto"><table class="w-full border-collapse tabular-nums">
                <thead><tr>
                    <th data-k="rank" class="num">#</th>
                    <th data-k="name">Card</th>
                    <th data-k="rarity">Rarity</th>
                    <th data-k="qty" class="num">Qty</th>
                    <th data-k="value" class="num">Value</th>
                    <th data-k="d7" class="num">7D</th>
                    <th data-k="pct" class="num" id="thRange">Range</th>
                    <th data-k="vol" class="num">Volatility</th>
                    <th>Trend</th>
                </tr></thead>
                <tbody id="tbody"></tbody>
            </table></div>
        </section>
    </main>

    <div class="modal" id="modal">
        <div class="relative w-full max-w-[980px] overflow-hidden rounded-xl border border-line bg-panel">
            <div class="flex items-center justify-between bg-dark-900 px-5 py-3">
                <img src="https://static.tcgcollector.com/build/images/tcgcollector-logo-with-text-light.15508095.svg" alt="TCG Collector" referrerpolicy="no-referrer" class="h-5 w-auto">
                <button id="mclose" aria-label="Close" class="grid size-8 cursor-pointer place-items-center rounded-md bg-dark-700 text-lg text-dark-100 hover:bg-brand hover:text-white">×</button>
            </div>
            <div id="modalBody"></div>
        </div>
    </div>

    <script type="application/json" id="dashboard-data" data-placeholder="{{ asset('images/card-placeholder.svg') }}">{{ data|raw }}</script>
{% endblock %}
